rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Access sessions are server-managed; business documents are never migrated.
  function hasAccess(){
   return request.auth != null && request.auth.token.louvor_access == true
    && request.auth.token.access_session is string
    && request.auth.token.access_session.matches('^[a-f0-9]{64}$')
    && request.auth.token.access_expires is int
    && request.auth.token.access_expires > request.time.toMillis()
    && exists(/databases/$(database)/documents/_access_sessions/$(request.auth.token.access_session))
    && get(/databases/$(database)/documents/_access_sessions/$(request.auth.token.access_session)).data.uid == request.auth.uid
    && get(/databases/$(database)/documents/_access_sessions/$(request.auth.token.access_session)).data.revoked == false
    && get(/databases/$(database)/documents/_access_sessions/$(request.auth.token.access_session)).data.expires_at > request.time;
  }
  function text(v,n){return v is string && v.size()<=n;}
  function title(v,n){return text(v,n) && v.size()>0;}
  function url(v){return text(v,1200) && (v=='' || v.matches('https?://.*'));}
  function common(d){return d.deleted is bool && d.created_at is timestamp && ((resource==null && d.created_at==request.time) || (resource!=null && d.created_at==resource.data.created_at));}
  match /members/{id} {
   allow read: if hasAccess();
   allow create,update: if hasAccess() && request.resource.data.keys().hasOnly(['name','role','phone','active','created_at','deleted']) && common(request.resource.data)
    && title(request.resource.data.name,120) && title(request.resource.data.role,80) && request.resource.data.active is bool && (!('phone' in request.resource.data) || text(request.resource.data.phone,32));
   allow delete: if false;
  }
  match /songs/{id} {
   allow read: if hasAccess();
   allow create,update: if hasAccess() && request.resource.data.keys().hasOnly(['title','artist','song_key','bpm','youtube_url','chords_url','notes','created_at','deleted']) && common(request.resource.data)
    && title(request.resource.data.title,180) && text(request.resource.data.artist,140) && text(request.resource.data.song_key,24)
    && (request.resource.data.bpm==null || (request.resource.data.bpm is int && request.resource.data.bpm>=20 && request.resource.data.bpm<=300))
    && url(request.resource.data.youtube_url) && url(request.resource.data.chords_url) && text(request.resource.data.notes,4000);
   allow delete: if false;
  }
  match /services/{id} {
   allow read: if hasAccess();
   allow create,update: if hasAccess() && request.resource.data.keys().hasOnly(['title','service_date','service_time','location','notes','team','tracks','created_at','deleted']) && common(request.resource.data)
    && title(request.resource.data.title,160) && request.resource.data.service_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.resource.data.service_time.matches('^[0-9]{2}:[0-9]{2}$') && text(request.resource.data.location,180) && text(request.resource.data.notes,4000)
    && request.resource.data.team is list && request.resource.data.team.size()<=100 && request.resource.data.tracks is list && request.resource.data.tracks.size()<=100;
   allow delete: if false;
  }
  // Cifras próprias/autorizadas separadas: nenhum cadastro antigo é migrado.
  match /charts/{songId} {
   allow read: if hasAccess();
   allow create,update: if hasAccess() && exists(/databases/$(database)/documents/songs/$(songId))
    && request.resource.data.keys().hasOnly(['song_id','content','original_key','revision','created_at','updated_at'])
    && request.resource.data.song_id == songId
    && title(request.resource.data.content,60000) && title(request.resource.data.original_key,24)
    && request.resource.data.revision is int
    && ((resource == null && request.resource.data.revision == 1 && request.resource.data.created_at == request.time)
     || (resource != null && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.created_at == resource.data.created_at))
    && request.resource.data.created_at is timestamp && request.resource.data.updated_at == request.time;
   allow delete: if false;
  }
  match /{document=**}{allow read,write:if false;}
 }
}
